<%- include('../partials/header', { title: deuda.nombre, active: 'deudas' }) %>

<div class="detalle-deuda">
  <div class="detalle-header">
    <a href="/deudas" class="btn-back">← Volver a deudas</a>
    <h2><%= deuda.nombre %></h2>
    <!-- ELIMINADO: botón de eliminar del header -->
  </div>

  <div class="deuda-resumen">
    <div class="resumen-item">
      <span class="label">Cuota</span>
      <span class="valor"><%= deuda.cuota_actual %>/<%= deuda.numero_cuotas %></span>
    </div>
    <div class="resumen-item">
      <span class="label">Cuota mínima</span>
      <span class="valor">$<%= deuda.cuota_minima.toLocaleString() %></span>
    </div>
    <div class="resumen-item">
      <span class="label">Total</span>
      <span class="valor">$<%= deuda.valor_total.toLocaleString() %></span>
    </div>
    <div class="resumen-item">
      <span class="label">Pagado</span>
      <span class="valor">$<%= deuda.pagado_total.toLocaleString() %></span>
    </div>
    <div class="resumen-item">
      <span class="label">Restante</span>
      <span class="valor">$<%= (deuda.valor_total - deuda.pagado_total).toLocaleString() %></span>
    </div>
    <div class="resumen-item">
      <span class="label">Día de pago</span>
      <span class="valor"><%= deuda.dia_pago %></span>
    </div>
  </div>

  <!-- Acciones (solo si no está archivada) -->
  <% if (deuda.archivada === 0) { %>
    <div class="deuda-acciones">
      <button class="btn-primary" id="btn-pago-minimo">💰 Pago mínimo</button>
      <button class="btn-secondary" id="btn-abono">➕ Abono</button>
      <% if (deuda.activa === 0) { %>
        <button class="btn-secondary" id="btn-archivar">📁 Archivar</button>
      <% } %>
      <!-- NUEVO: botón Eliminar (siempre visible, incluso si está archivada) -->
      <button class="btn-danger btn-eliminar-deuda" data-id="<%= deuda.id %>">🗑️ Eliminar</button>
    </div>
  <% } else { %>
    <!-- Si está archivada, solo mostrar el botón Eliminar -->
    <div class="deuda-acciones">
      <button class="btn-danger btn-eliminar-deuda" data-id="<%= deuda.id %>">🗑️ Eliminar</button>
    </div>
  <% } %>

  <!-- Modal para abono -->
  <div id="modal-abono" class="modal hidden">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>Abono a la deuda</h2>
      <form id="form-abono">
        <label>Monto (COP) <input type="number" step="0.01" id="monto-abono" required></label>
        <button type="submit" class="btn-primary">Aplicar abono</button>
      </form>
    </div>
  </div>

  <!-- Historial de pagos -->
  <h3 class="pagos-titulo">📋 Historial de pagos</h3>
  <div class="pagos-list">
    <% if (pagos.length === 0) { %>
      <p class="empty">No hay pagos registrados.</p>
    <% } else { %>
      <% pagos.forEach(p => { %>
        <div class="pago-item <%= p.tipo %>">
          <span class="pago-fecha"><%= new Date(p.fecha_pago).toLocaleDateString() %> <%= new Date(p.fecha_pago).toLocaleTimeString() %></span>
          <span class="pago-monto">$<%= p.monto.toLocaleString() %></span>
          <span class="pago-tipo"><%= p.tipo === 'minimo' ? 'Mínimo' : p.tipo === 'abono' ? 'Abono' : 'Total' %></span>
          <button class="btn-eliminar-pago" data-id="<%= p.id %>" title="Eliminar este pago">✕</button>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
