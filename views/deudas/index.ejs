<%- include('../partials/header', { title: 'Deudas', active: 'deudas' }) %>

<div class="toolbar">
  <h1>💳 Mis Deudas</h1>
  <div>
    <button class="btn-primary" id="btn-agregar-deuda">➕ Nueva deuda</button>
  </div>
</div>

<!-- Modal para agregar deuda -->
<div id="modal-deuda" class="modal hidden">
  <div class="modal-content">
    <span class="close">&times;</span>
    <h2>Agregar deuda</h2>
    <form id="form-deuda">
      <label>Nombre <input type="text" id="nombre-deuda" required placeholder="Ej: Préstamo"></label>
      <label>Valor total (COP) <input type="number" step="0.01" id="valor-total" required></label>
      <label>Cuota mínima (COP) <input type="number" step="0.01" id="cuota-minima" required></label>
      <label>Número de cuotas <input type="number" id="numero-cuotas" required min="1"></label>
      <label>Fecha de pago <input type="date" id="fecha-pago" required></label>
      <button type="submit" class="btn-primary">Crear deuda</button>
    </form>
  </div>
</div>

<!-- Grid de deudas -->
<div class="deudas-grid">
  <% if (deudas.length === 0) { %>
    <p class="empty" style="grid-column: 1 / -1;">No tienes deudas registradas.</p>
  <% } else { %>
    <% deudas.forEach(d => { %>
      <div class="deuda-card" onclick="window.location='/deudas/<%= d.id %>'">
        <div class="deuda-header">
          <span class="deuda-cuota"><%= d.cuota_actual %>/<%= d.numero_cuotas %></span>
        </div>
        <h3><%= d.nombre %></h3>
        <div class="deuda-montos">
          <span class="deuda-total">Total: $<%= d.valor_total.toLocaleString() %></span>
          <span class="deuda-pagado">Pagado: $<%= d.pagado_total.toLocaleString() %></span>
          <span class="deuda-minima">Cuota mínima: $<%= d.cuota_minima.toLocaleString() %></span>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
