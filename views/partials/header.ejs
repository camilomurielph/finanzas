<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title || 'Finanzas' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <!-- Overlay para cerrar menú -->
  <div class="overlay" id="menu-overlay"></div>

  <div class="app-container">
    <!-- Menú lateral (drawer) -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <h2>💰 Finanzas</h2>
        <button class="close-menu" id="close-menu" aria-label="Cerrar menú">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <nav>
        <ul>
<li>
  <a href="/" class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>">
    <i class="fas fa-home"></i> Inicio
  </a>
</li>
          <li>
            <a href="/gastos" class="<%= typeof active !== 'undefined' && active === 'gastos' ? 'active' : '' %>">
              <i class="fas fa-wallet"></i> Gastos
            </a>
          </li>
          <li>
            <a href="/suscripciones" class="<%= typeof active !== 'undefined' && active === 'suscripciones' ? 'active' : '' %>">
              <i class="fas fa-repeat"></i> Suscripciones
            </a>
          </li>
<li>
  <a href="/bolsillos" class="<%= typeof active !== 'undefined' && active === 'bolsillos' ? 'active' : '' %>">
    <i class="fas fa-piggy-bank"></i> Bolsillos
  </a>
</li>
<li>
  <a href="/salario" class="<%= typeof active !== 'undefined' && active === 'salario' ? 'active' : '' %>">
    <i class="fas fa-coins"></i> Salario
  </a>
</li>
<li>
  <a href="/deudas" class="<%= typeof active !== 'undefined' && active === 'deudas' ? 'active' : '' %>">
    <i class="fas fa-credit-card"></i> Deudas
  </a>
</li>
<li>
  <a href="/reporte" class="<%= typeof active !== 'undefined' && active === 'reporte' ? 'active' : '' %>">
    <i class="fas fa-chart-bar"></i> Reporte
  </a>
</li>
          <!-- Aquí se agregarán más herramientas en el futuro -->
          <% if (user) { %>
            <li>
              <a href="/logout">
                <i class="fas fa-sign-out-alt"></i> Cerrar sesión
              </a>
            </li>
          <% } %>
        </ul>
      </nav>
      <div class="sidebar-user">
        <i class="fas fa-user-circle"></i> <%= user ? user.email : '' %>
      </div>
    </aside>

    <!-- Contenido principal -->
    <main class="main-content">
      <!-- Barra superior con hamburguesa y título -->
      <header class="topbar">
        <button class="hamburger" id="hamburger" aria-label="Abrir menú">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <h1 class="page-title"><%= title || 'Finanzas' %></h1>
        <div class="topbar-actions"></div>
      </header>

      <!-- Aquí se inyecta el contenido de cada vista -->
