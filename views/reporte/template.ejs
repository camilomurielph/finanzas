<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reporte Financiero</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #0d0d0d;
      color: #e0e0e0;
      padding: 30px;
    }
    .container {
      max-width: 1100px;
      margin: 0 auto;
      background: #1a1a1a;
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }
    h1 {
      font-size: 28px;
      color: #fff;
      border-bottom: 2px solid #3b82f6;
      padding-bottom: 15px;
      margin-bottom: 25px;
    }
    h2 {
      font-size: 20px;
      color: #3b82f6;
      margin: 25px 0 15px 0;
      border-bottom: 1px solid #2a2a2a;
      padding-bottom: 8px;
    }
    h3 {
      font-size: 16px;
      color: #b0b0b0;
      margin: 15px 0 10px 0;
    }
    .info-usuario {
      display: flex;
      justify-content: space-between;
      color: #888;
      font-size: 14px;
      margin-bottom: 20px;
    }
    .resumen-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      margin-bottom: 25px;
    }
    .resumen-item {
      background: #121212;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      border: 1px solid #2a2a2a;
    }
    .resumen-item .label {
      display: block;
      font-size: 12px;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .resumen-item .valor {
      display: block;
      font-size: 24px;
      font-weight: 700;
      margin-top: 5px;
    }
    .resumen-item .valor.positivo {
      color: #51cf66;
    }
    .resumen-item .valor.negativo {
      color: #ff6b6b;
    }
    .resumen-item .valor.neutral {
      color: #3b82f6;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 10px 0 20px 0;
      font-size: 14px;
    }
    th {
      text-align: left;
      background: #121212;
      padding: 10px 12px;
      color: #888;
      font-weight: 600;
      border-bottom: 2px solid #2a2a2a;
    }
    td {
      padding: 8px 12px;
      border-bottom: 1px solid #1a1a1a;
    }
    .table-total {
      font-weight: 700;
      color: #3b82f6;
    }
    .badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge.activo {
      background: rgba(81, 207, 102, 0.2);
      color: #51cf66;
    }
    .badge.pagado {
      background: rgba(81, 207, 102, 0.2);
      color: #51cf66;
    }
    .badge.pendiente {
      background: rgba(255, 107, 107, 0.2);
      color: #ff6b6b;
    }
    .footer {
      margin-top: 30px;
      padding-top: 15px;
      border-top: 1px solid #2a2a2a;
      text-align: center;
      font-size: 12px;
      color: #666;
    }
    .resumen-total {
      font-size: 16px;
      font-weight: 600;
      color: #fff;
      background: #121212;
      padding: 12px 16px;
      border-radius: 8px;
      margin-top: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>📊 Reporte Financiero</h1>
    
    <div class="info-usuario">
      <span>👤 <strong><%= usuario %></strong></span>
      <span>📅 <strong><%= fechaGeneracion %></strong></span>
    </div>

    <!-- RESUMEN EJECUTIVO -->
    <h2>📋 Resumen Ejecutivo</h2>
    <div class="resumen-grid">
      <div class="resumen-item">
        <span class="label">Total Gastos</span>
        <span class="valor negativo">- $<%= resumen.totalGastos.toLocaleString() %></span>
      </div>
      <div class="resumen-item">
        <span class="label">Total Suscripciones</span>
        <span class="valor negativo">- $<%= resumen.totalSuscripciones.toLocaleString() %></span>
      </div>
      <div class="resumen-item">
        <span class="label">Total Bolsillos</span>
        <span class="valor positivo">$<%= resumen.totalBolsillos.toLocaleString() %></span>
      </div>
      <div class="resumen-item">
        <span class="label">Total Deudas</span>
        <span class="valor negativo">- $<%= resumen.totalDeudas.toLocaleString() %></span>
      </div>
      <div class="resumen-item">
        <span class="label">Salario Disponible</span>
        <span class="valor neutral">$<%= resumen.salarioDisponible.toLocaleString() %></span>
      </div>
      <div class="resumen-item">
        <span class="label">Ahorro (Simulador)</span>
        <span class="valor positivo">$<%= resumen.salarioAhorro.toLocaleString() %></span>
      </div>
    </div>

    <!-- GASTOS -->
    <h2>💳 Gastos</h2>
    <h3>Últimos gastos registrados</h3>
    <% if (detalles.gastos.recientes.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Fecha</th>
            <th style="text-align:right">Valor</th>
          </tr>
        </thead>
        <tbody>
          <% detalles.gastos.recientes.forEach(g => { %>
            <tr>
              <td><%= g.nombre %></td>
              <td><%= g.tipo_nombre %></td>
              <td><%= new Date(g.fecha).toLocaleDateString() %></td>
              <td style="text-align:right">$<%= g.valor_total.toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p style="color:#666;">No hay gastos registrados.</p>
    <% } %>

    <h3>Gastos por categoría</h3>
    <% if (detalles.gastos.porCategoria.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Categoría</th>
            <th style="text-align:right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% detalles.gastos.porCategoria.forEach(c => { %>
            <tr>
              <td><%= c.nombre %></td>
              <td style="text-align:right">$<%= c.total.toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p style="color:#666;">No hay categorías con gastos.</p>
    <% } %>

    <!-- SUSCRIPCIONES -->
    <h2>🔄 Suscripciones</h2>
    <% if (detalles.suscripciones.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Nombre</th>
            <th style="text-align:center">Día de pago</th>
            <th style="text-align:right">Valor mensual</th>
          </tr>
        </thead>
        <tbody>
          <% detalles.suscripciones.forEach(s => { %>
            <tr>
              <td><%= s.nombre %></td>
              <td style="text-align:center"><%= s.dia_pago %></td>
              <td style="text-align:right">$<%= s.valor.toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="resumen-total">
        <span>Total mensual en suscripciones:</span>
        <span>$<%= resumen.totalSuscripciones.toLocaleString() %></span>
      </div>
    <% } else { %>
      <p style="color:#666;">No hay suscripciones registradas.</p>
    <% } %>

    <!-- BOLSILLOS -->
    <h2>🏦 Bolsillos</h2>
    <table>
      <thead>
        <tr>
          <th>Bolsillo</th>
          <th style="text-align:right">Saldo</th>
        </tr>
      </thead>
      <tbody>
        <% if (detalles.bolsillos.length > 0) { %>
          <% detalles.bolsillos.forEach(b => { %>
            <tr>
              <td><%= b.nombre %></td>
              <td style="text-align:right">$<%= b.saldo.toLocaleString() %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="2" style="color:#666;">No hay bolsillos creados.</td></tr>
        <% } %>
      </tbody>
    </table>
    <div class="resumen-total">
      <span>Total en todos los bolsillos:</span>
      <span>$<%= resumen.totalBolsillos.toLocaleString() %></span>
    </div>

    <!-- SUB-BOLSILLOS -->
    <% if (detalles.subBolsillos.length > 0) { %>
      <h3>Sub-bolsillos (categorías)</h3>
      <table>
        <thead>
          <tr>
            <th>Sub-bolsillo</th>
            <th>Bolsillo</th>
            <th style="text-align:right">Saldo</th>
          </tr>
        </thead>
        <tbody>
          <% detalles.subBolsillos.forEach(sb => { %>
            <tr>
              <td><%= sb.nombre %></td>
              <td><%= sb.bolsillo_nombre %></td>
              <td style="text-align:right">$<%= sb.saldo.toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <!-- DEUDAS -->
    <h2>💳 Deudas activas</h2>
    <% if (detalles.deudas.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Nombre</th>
            <th style="text-align:center">Cuota</th>
            <th style="text-align:center">Día de pago</th>
            <th style="text-align:right">Total</th>
            <th style="text-align:right">Pagado</th>
            <th style="text-align:right">Restante</th>
          </tr>
        </thead>
        <tbody>
          <% detalles.deudas.forEach(d => { %>
            <tr>
              <td><%= d.nombre %></td>
              <td style="text-align:center"><%= d.cuota_actual %>/<%= d.numero_cuotas %></td>
              <td style="text-align:center"><%= d.dia_pago %></td>
              <td style="text-align:right">$<%= d.valor_total.toLocaleString() %></td>
              <td style="text-align:right;color:#51cf66;">$<%= d.pagado_total.toLocaleString() %></td>
              <td style="text-align:right;color:#ff6b6b;">$<%= (d.valor_total - d.pagado_total).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="resumen-total">
        <span>Total adeudado en deudas:</span>
        <span>$<%= resumen.totalDeudas.toLocaleString() %></span>
      </div>
    <% } else { %>
      <p style="color:#666;">No hay deudas activas.</p>
    <% } %>

    <!-- SALARIO -->
    <h2>💰 Simulador de Salario</h2>
    <% if (detalles.salario.simulacro) { 
      const s = detalles.salario.simulacro;
    %>
      <table>
        <thead>
          <tr>
            <th>Concepto</th>
            <th style="text-align:right">Monto</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Salario inicial</td>
            <td style="text-align:right">$<%= s.salario_inicial.toLocaleString() %></td>
          </tr>
          <tr>
            <td>Disponible</td>
            <td style="text-align:right;color:#3b82f6;">$<%= s.saldo_disponible.toLocaleString() %></td>
          </tr>
          <tr>
            <td>Ahorro acumulado</td>
            <td style="text-align:right;color:#51cf66;">$<%= s.ahorro.toLocaleString() %></td>
          </tr>
        </tbody>
      </table>

      <% if (detalles.salario.gastos.length > 0) { %>
        <h3>Gastos del simulacro</h3>
        <table>
          <thead>
            <tr>
              <th>Nombre</th>
              <th style="text-align:right">Valor</th>
            </tr>
          </thead>
          <tbody>
            <% detalles.salario.gastos.forEach(g => { %>
              <tr>
                <td><%= g.nombre %></td>
                <td style="text-align:right;color:#ff6b6b;">-$<%= g.valor.toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    <% } else { %>
      <p style="color:#666;">No hay simulacro de salario activo.</p>
    <% } %>

    <div class="footer">
      <p>📊 Reporte generado automáticamente - Finanzas App</p>
      <p style="color:#555;">Este reporte es un resumen de tus finanzas personales al <%= fechaGeneracion %></p>
    </div>
  </div>
</body>
</html>
