<%- include('../partials/header', { title: 'Reporte Financiero', active: 'reporte' }) %>

<div class="toolbar">
  <h1>📊 Reporte Financiero</h1>
  <div>
    <button class="btn-primary" id="btn-generar-pdf">📄 Descargar PDF</button>
  </div>
</div>

<div class="reporte-info">
  <p>Genera un reporte en PDF con un resumen completo de todas tus finanzas.</p>
  <ul>
    <li>✅ Resumen ejecutivo de tus finanzas</li>
    <li>✅ Detalle de gastos, suscripciones, bolsillos y deudas</li>
    <li>✅ Análisis del simulador de salario</li>
    <li>✅ Diseño profesional para compartir o analizar</li>
  </ul>
  <p><strong>Ideal para:</strong></p>
  <ul>
    <li>🤖 Enviar a una IA para análisis financiero</li>
    <li>📋 Hacer seguimiento mensual de tus finanzas</li>
    <li>💰 Identificar áreas de mejora en tus finanzas</li>
  </ul>
</div>

<!-- Modal para solicitar nombre -->
<div id="modal-nombre" class="modal hidden">
  <div class="modal-content">
    <span class="close">&times;</span>
    <h2>Ingresa tu nombre</h2>
    <p style="color: var(--text-muted); margin-bottom: 16px;">
      El nombre aparecerá en el reporte PDF.
    </p>
    <form id="form-nombre">
      <label>Nombre completo <input type="text" id="nombre-usuario" required placeholder="Ej: Juan Pérez"></label>
      <button type="submit" class="btn-primary">Generar PDF</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
